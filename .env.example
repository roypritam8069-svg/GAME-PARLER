# ============================================================
# GAME PARLOUR — ENVIRONMENT VARIABLES
# ============================================================
#
# Copy this file to:
#
# .env.local
#
# Never commit real secrets.
# ============================================================


# ============================================================
# DATABASE
# ============================================================

# Local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/game_parlour?schema=public"

# Production — Supabase
# Replace placeholders with real credentials.
#
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public"

# Direct database connection for Prisma migrations
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/game_parlour?schema=public"


# ============================================================
# APPLICATION
# ============================================================

NODE_ENV="development"

NEXT_PUBLIC_APP_URL="http://localhost:3000"


# ============================================================
# AUTHENTICATION
# ============================================================

# Generate a strong random secret.
# Example:
# openssl rand -base64 32

SESSION_SECRET=""


# ============================================================
# PAYMENT
# MVP = COUNTER ONLY
# See DECISIONS.md — ADR-003
# ============================================================

PAYMENT_PROVIDER="counter"

PAYMENT_KEY_ID=""

PAYMENT_KEY_SECRET=""

PAYMENT_WEBHOOK_SECRET=""


# ============================================================
# WHATSAPP
# MVP = MANUAL
# See DECISIONS.md — ADR-004
# ============================================================

WHATSAPP_PROVIDER="manual"

WHATSAPP_PHONE_NUMBER=""

WHATSAPP_API_TOKEN=""


# ============================================================
# BACKUP
# ============================================================

BACKUP_DIR="./backups"
